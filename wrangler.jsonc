{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sili",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "f80a9d56-02d8-4056-9281-bd11333c8ce3","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "86122bfdd7eb4afa8db62f73cd2a005c" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
